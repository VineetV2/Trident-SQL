# Settings for run_all.sh. Copy to pipeline.env and edit. Only WORK is required; everything else has a default under it.

# A folder with about 200 GB free: models, data, Python environments, indexes and runs all go here.
WORK=/path/to/a/big/disk/text2sql_work

# The two 80 GB GPUs to use (as numbered by nvidia-smi).
GPUS=0,1

# Name of the run (its results go to $WORK/runs/<RUN_NAME>).
RUN_NAME=dev-run

# --- Optional: point at things you already have (leave empty to let setup create them under WORK) ---
# PIPE_PY_ENV=           # the pipeline's Python environment (Python 3.12, requirements.lock) (default $WORK/envs/pipeline)
# HF_HOME=               # Hugging Face cache holding gpt-oss-120b and Qwen3-Embedding-0.6B (default $WORK/hf)
# BIRD_ROOT=             # BIRD data: dev/dev.json, dev/dev_databases/, train/train.json  (default $WORK/data/bird)
# PREP_DIR=              # our writer's per-database columns.json (default $WORK/data/prep/dev)
# VSTORE=                # value index (default $WORK/vector_store; built by the run when empty)
# FEWSHOT_INDEX=         # index of solved training questions (default $WORK/few_shot_index; built when empty)
# RUNS_DIR=              # where runs are written (default $WORK/runs)
